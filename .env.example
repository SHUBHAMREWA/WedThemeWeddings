# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/wedtheme

# Cloudinary credentials (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Folder in Cloudinary where all uploads go
CLOUDINARY_FOLDER=wedtheme

# Admin login. The first successful login creates this admin in MongoDB.
ADMIN_EMAIL=admin@wedtheme.in
ADMIN_PASSWORD=change-me-strong-password

# Long random string used to sign the admin session cookie
AUTH_SECRET=replace-with-a-long-random-string
